# Copy to .env and fill in. Never commit .env or put these values in frontend code.
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=            # long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STRIPE_SECRET_KEY=         # sk_test_... (Stripe Dashboard > Developers > API keys)
STRIPE_PUBLISHABLE_KEY=    # pk_test_... (not used by hosted Checkout, reserved)
STRIPE_WEBHOOK_SECRET=     # whsec_... (Developers > Webhooks, endpoint: BASE_URL/api/stripe-webhook, event: checkout.session.completed)
GOOGLE_CLIENT_ID=          # Google Cloud Console > OAuth client. Redirect URI: BASE_URL/auth/google/callback
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=           # developers.facebook.com. Valid OAuth redirect: BASE_URL/auth/facebook/callback
FACEBOOK_APP_SECRET=
RESEND_API_KEY=            # optional: transactional email (verification, reset, order confirmation)
MAIL_FROM=AURELIS <orders@yourdomain.com>

# --- Admin dashboard (/admin) ---
ADMIN_EMAIL=               # the only account allowed into /admin
ADMIN_PASSWORD_HASH=       # generate: node scripts/hash-password.js "a-long-password"
